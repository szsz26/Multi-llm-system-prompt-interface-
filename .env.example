# API keys for providers that have no official CLI (or that you prefer over the CLI).
# Copy this file to `.env` and fill in the keys you have. Leave the rest blank to
# auto-disable that provider.

# Grok (x.ai) — https://console.x.ai
XAI_API_KEY=

# Perplexity — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Optional: use the Anthropic API for the AI synthesis/compare step and/or as the
# Claude provider instead of the `claude` CLI.
ANTHROPIC_API_KEY=

# Optional: use the OpenAI API directly instead of the `codex` CLI.
OPENAI_API_KEY=

# Optional: use the Gemini API directly instead of the `gemini` CLI.
GEMINI_API_KEY=
